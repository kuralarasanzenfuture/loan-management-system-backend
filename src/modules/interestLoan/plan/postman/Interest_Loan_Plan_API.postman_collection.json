{
  "info": {
    "_postman_id": "e49f8712-4cf3-4c91-bdf6-3829ad024982",
    "name": "Interest Loan Plan API",
    "description": "Comprehensive Postman collection for managing Interest Loan Plans (Migration 026) in the Loan Management System. Supports creating plans with auto or custom plan codes, querying active plans for loan creation dropdowns, paginated lists with filters, partial updates, status changes, and guarded deletions.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "YOUR_JWT_ACCESS_TOKEN",
      "type": "string"
    },
    {
      "key": "planId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Create Plans",
      "item": [
        {
          "name": "Create Plan (Auto-generate Code)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var json = pm.response.json();",
                  "    if (json.data && json.data.id) {",
                  "        pm.collectionVariables.set('planId', json.data.id);",
                  "        console.log('Saved planId:', json.data.id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"plan_name\": \"Monthly 2% Simple\",\n  \"interest_type\": \"percentage\",\n  \"interest_value\": 2.0,\n  \"interest_frequency\": \"monthly\",\n  \"calculation_method\": \"simple\",\n  \"principal_basis\": \"outstanding_principal\",\n  \"payment_type\": \"anytime\",\n  \"description\": \"Standard monthly 2% interest plan calculated on outstanding principal with anytime payment.\",\n  \"status\": \"active\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/interest-loan-plans",
              "host": ["{{baseUrl}}"],
              "path": ["api", "interest-loan-plans"]
            },
            "description": "Creates a new interest loan plan. If plan_code is omitted, the backend auto-generates a clean code like 'INT-MONTHLY-2'."
          },
          "response": []
        },
        {
          "name": "Create Plan (Custom Code - Monthly 3%)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var json = pm.response.json();",
                  "    if (json.data && json.data.id) {",
                  "        pm.collectionVariables.set('planId', json.data.id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"plan_name\": \"Monthly 3% Special\",\n  \"plan_code\": \"INT-MONTHLY-3\",\n  \"interest_type\": \"percentage\",\n  \"interest_value\": 3.0,\n  \"interest_frequency\": \"monthly\",\n  \"calculation_method\": \"simple\",\n  \"principal_basis\": \"outstanding_principal\",\n  \"payment_type\": \"anytime\",\n  \"description\": \"Monthly 3% interest plan with custom plan code.\",\n  \"status\": \"active\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/interest-loan-plans",
              "host": ["{{baseUrl}}"],
              "path": ["api", "interest-loan-plans"]
            },
            "description": "Creates a new interest loan plan with an explicitly supplied unique plan code."
          },
          "response": []
        },
        {
          "name": "Create Plan (Weekly 1%)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"plan_name\": \"Weekly 1% Fast Cash\",\n  \"plan_code\": \"INT-WEEKLY-1\",\n  \"interest_type\": \"percentage\",\n  \"interest_value\": 1.0,\n  \"interest_frequency\": \"weekly\",\n  \"calculation_method\": \"simple\",\n  \"principal_basis\": \"outstanding_principal\",\n  \"payment_type\": \"anytime\",\n  \"description\": \"Weekly collection interest loan plan.\",\n  \"status\": \"active\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/interest-loan-plans",
              "host": ["{{baseUrl}}"],
              "path": ["api", "interest-loan-plans"]
            },
            "description": "Creates a weekly interest loan plan."
          },
          "response": []
        },
        {
          "name": "Create Plan (Daily 1% Plan)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"plan_name\": \"Daily 1% Plan\",\n  \"interest_type\": \"percentage\",\n  \"interest_value\": 1.0,\n  \"interest_frequency\": \"daily\",\n  \"calculation_method\": \"simple\",\n  \"principal_basis\": \"outstanding_principal\",\n  \"payment_type\": \"anytime\",\n  \"description\": \"Daily simple interest loan plan.\",\n  \"status\": \"active\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/interest-loan-plans",
              "host": ["{{baseUrl}}"],
              "path": ["api", "interest-loan-plans"]
            },
            "description": "Creates a daily interest loan plan with auto-generated code."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Get Plans",
      "item": [
        {
          "name": "Get All Plans (With Pagination & Filters)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/interest-loan-plans?status=active&interest_frequency=monthly&page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "interest-loan-plans"],
              "query": [
                {
                  "key": "status",
                  "value": "active",
                  "description": "Filter by status: active | inactive"
                },
                {
                  "key": "interest_frequency",
                  "value": "monthly",
                  "description": "Filter by frequency: daily | weekly | monthly | yearly"
                },
                {
                  "key": "interest_type",
                  "value": "percentage",
                  "disabled": true,
                  "description": "Filter by type: percentage | fixed"
                },
                {
                  "key": "principal_basis",
                  "value": "outstanding_principal",
                  "disabled": true,
                  "description": "Filter by basis: original_principal | outstanding_principal"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            },
            "description": "Retrieves all interest loan plans with optional pagination and filtering."
          },
          "response": []
        },
        {
          "name": "Search Plans by Keyword",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/interest-loan-plans?search=Monthly",
              "host": ["{{baseUrl}}"],
              "path": ["api", "interest-loan-plans"],
              "query": [
                {
                  "key": "search",
                  "value": "Monthly",
                  "description": "Search keyword matching plan_name or plan_code"
                }
              ]
            },
            "description": "Searches for plans by plan name or plan code."
          },
          "response": []
        },
        {
          "name": "Get Active Plans (Dropdown List)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/interest-loan-plans/active",
              "host": ["{{baseUrl}}"],
              "path": ["api", "interest-loan-plans", "active"]
            },
            "description": "Retrieves only active interest loan plans. Optimized for dropdown selection when creating an interest loan."
          },
          "response": []
        },
        {
          "name": "Get Plan By ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/interest-loan-plans/{{planId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "interest-loan-plans", "{{planId}}"]
            },
            "description": "Retrieves details of a single plan by its ID, including creator and updater details."
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Update & Manage Plans",
      "item": [
        {
          "name": "Update Plan Details",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"plan_name\": \"Monthly 2.5% Revised\",\n  \"interest_value\": 2.5,\n  \"description\": \"Updated interest rate to 2.5% per month.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/interest-loan-plans/{{planId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "interest-loan-plans", "{{planId}}"]
            },
            "description": "Updates fields of an existing interest loan plan. Requires at least one field."
          },
          "response": []
        },
        {
          "name": "Update Plan Status (Activate / Deactivate)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"inactive\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/interest-loan-plans/{{planId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "interest-loan-plans", "{{planId}}", "status"]
            },
            "description": "Toggles plan status between 'active' and 'inactive'."
          },
          "response": []
        },
        {
          "name": "Delete Plan",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/interest-loan-plans/{{planId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "interest-loan-plans", "{{planId}}"]
            },
            "description": "Deletes an interest loan plan. If the plan is currently linked to any existing loans in 'interest_loans', deletion is automatically rejected to preserve integrity."
          },
          "response": []
        }
      ]
    }
  ]
}
